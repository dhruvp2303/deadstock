APP_NAME="DeadStock"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.deadstock.com
FRONTEND_URL=https://deadstock.com
CORS_ALLOWED_ORIGINS=https://deadstock.com,https://app.deadstock.com,http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

# Enterprise Big Database Configuration (Choose: pgsql, mysql, or sqlite)
# Option A: High-scale PostgreSQL (Supabase / AWS RDS / Neon / GCP Cloud SQL)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=deadstock_prod
# DB_USERNAME=deadstock_user
# DB_PASSWORD=your_secure_password
# DB_SSLMODE=prefer

# Option B: High-scale MySQL / MariaDB (Percona / AWS Aurora)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=deadstock_prod
# DB_USERNAME=root
# DB_PASSWORD=your_secure_password

# Option C: Embedded SQLite (Local Development)
DB_CONNECTION=sqlite

# Performance Caching & Sessions (Redis Recommended for Big Database Scale)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis Configuration (Optional for Enterprise Throughput)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Production Mail Driver (SMTP / Resend / Postmark / SES)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@deadstock.com"
MAIL_FROM_NAME="DeadStock Platform"

# AI Predictive Engine
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY=your-secure-ai-key
