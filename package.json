{
  "name": "deadstock",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "dev:backend": "cd backend && php artisan serve",
    "dev:all": "concurrently \"npm --prefix frontend run dev\" \"cd backend && php artisan serve\""
  }
}
